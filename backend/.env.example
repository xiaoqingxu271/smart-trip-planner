# ========= 智能旅行助手 后端配置 =========
# 复制本文件为 .env 并填入你自己的密钥

# ---------- LLM（OpenAI 兼容接口均可） ----------
# DeepSeek 示例
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
# OpenAI 示例
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_ID=gpt-4o
# 智谱 GLM 示例
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_ID=glm-4-flash

# ---------- 高德开放平台（https://console.amap.com） ----------
# 「Web 服务」类型的 Key：供 MCP 服务器调用（POI 搜索 / 天气 / 路径规划）
# 商用部署必须使用「企业认证」Key（个人认证搜索类月配额仅 5000 次 / QPS 3，
# 只能支撑约百次规划/月，且官方规定商用需企业认证主体）
AMAP_API_KEY=你的高德Web服务Key
# 「Web 端(JS API)」类型的 Key：供前端地图展示使用
AMAP_JS_KEY=你的高德JS API Key
# 「Web 端(JS API)」Key 配套的安全密钥（2021-12 之后申请的 Key 必填）
AMAP_JS_SECRET=
# 高德服务调用节流 QPS：个人认证 3.0、企业认证（乘风计划）30、技术服务许可 100
# 全局节拍器按 1/AMAP_QPS 作为相邻高德调用的最小间隔（图片/路线/MCP 搜索共用）
AMAP_QPS=3.0

# ---------- 高德 MCP 服务器 ----------
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=["-y", "@amap/amap-maps-mcp-server"]

# ---------- Unsplash（景点配图，可选） ----------
# https://unsplash.com/developers 申请，留空则景点不配图
UNSPLASH_ACCESS_KEY=

# ---------- MySQL（行程持久化，唯一事实来源） ----------
# 需先执行 backend/sql/init.sql 建库建表（应用启动时也会自动尝试执行）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trip_planner

# ---------- Redis（缓存/收藏排行/规划锁，可降级，不部署可留空） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 应用 ----------
# 端到端演示模式：不调用 LLM / 高德 / Unsplash，直接返回示例行程
DEMO_MODE=false

# ---------- 访问码鉴权（单管理员密码模式，可选） ----------
# 留空 = 关闭鉴权（本地演示，行为与从前一致）；
# 配置后所有 /api/* 需携带访问码（前端会出现登录页，存 localStorage）
APP_PASSWORD=

# ---------- 多用户体系 ----------
# user（默认）= 开放注册 + 登录后使用，行程按用户隔离；none = 无鉴权（仅本机演示，公网部署勿关）
# user 模式下忽略 APP_PASSWORD；示例作品与无主历史行程全员可读、仅可由本人改删
AUTH_MODE=user

# ---------- 限流（每 IP 固定窗口计数，存 Redis；Redis 不可用时自动放行） ----------
# 格式 "次数/窗口秒"；RATE_LIMIT_ENABLED=false 可整体关闭（压测/演示用）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_HEAVY=5/300
RATE_LIMIT_GEO=30/60
RATE_LIMIT_IMG=120/60
RATE_LIMIT_DEFAULT=120/60

# ---------- 用户级规划配额（成本护栏，多用户模式） ----------
# 每个登录用户每天可触发的规划次数（含 re-plan），超限返回 429；0 = 关闭
QUOTA_PLAN_DAILY=3

# ---------- 账号级登录锁定（与 RATE_LIMIT_AUTH 的 IP 限流互补） ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ---------- 行程分享链接 ----------
# 分享令牌有效期（天）；过期后链接失效，可随时经「撤销分享」立即失效
SHARE_TTL_DAYS=30
# 对外公开基址：拼接分享链接用。留空则用请求 Host（本地调试为 127.0.0.1:8000）。
# 公网/域名部署必须配置（如 https://trip.example.com），否则分享链接指向本机、外部无法访问。
PUBLIC_BASE_URL=

# ---------- 运维指标端点（/api/metrics，Prometheus 采集） ----------
# 采集令牌；留空则关闭该端点（返回 404）。仅在需要被监控系统抓取时配置。
# 采集方式：GET /api/metrics?metrics_token=<令牌> 或请求头 X-Metrics-Token。
# METRICS_TOKEN=
